# PhishGuard — copy to .env and override as needed.
ENVIRONMENT=dev
LOG_LEVEL=INFO
# MODELS_DIR=artifacts/models
# DATABASE_URL=sqlite:///./data/phishguard.db
# API_KEY=
CORS_ORIGINS=http://localhost:8501,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=65536
MODEL_VERSION=2026.1
GIT_SHA=dev
PHISHGUARD_API_URL=http://127.0.0.1:8000
